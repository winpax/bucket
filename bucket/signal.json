    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://updates.signal.org/desktop/signal-desktop-win-8.35.0.exe#/dl.7z",
            "hash": "sha512:a59f782b6b65bc49b8b57a4b1c0d624231842dd37ac723c4d1f8564d0b3e20310c7c14bda5acb3206ef73283dc9377d86ecd29de8d1b49799104e4f877e51da7",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
